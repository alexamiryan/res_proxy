{
  "manifest_version": 3,
  "name": "ResProxy",
  "description": "Residential proxy with IP reputation checks, auto-rotation, kill switch and optional WireGuard / Mullvad chaining.",
  "version": "0.0.0",
  "minimum_chrome_version": "133",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "ResProxy", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": [
    "proxy", "storage", "alarms", "webRequest", "webRequestAuthProvider", "declarativeNetRequestWithHostAccess",
    "privacy", "notifications", "nativeMessaging", "browsingData"
  ],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [{ "resources": ["blocked.html"], "matches": ["<all_urls>"] }],
  "incognito": "spanning"
}
